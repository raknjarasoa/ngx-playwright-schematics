import { test as base, expect } from '@playwright/test';
import AxeBuilder from '@axe-core/playwright';

export type A11yFixtures = {
  makeAxeBuilder: () => AxeBuilder;
  checkA11y: (options?: {
    context?: string;
    disabledRules?: string[];
  }) => Promise<void>;
};

export const a11yFixture = base.extend<A11yFixtures>({
  makeAxeBuilder: async ({ page }, use) => {
    const factory = () =>
      new AxeBuilder({ page })
        .withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa', 'wcag22aa']);
    await use(factory);
  },

  checkA11y: async ({ makeAxeBuilder }, use, testInfo) => {
    const runA11y = async (options?: {
      context?: string;
      disabledRules?: string[];
    }) => {
      let builder = makeAxeBuilder();
      if (options?.disabledRules) {
        builder = builder.disableRules(options.disabledRules);
      }
      if (options?.context) {
        builder = builder.include(options.context);
      }

      const results = await builder.analyze();

      if (results.violations.length > 0) {
        await testInfo.attach('accessibility-violations', {
          body: JSON.stringify(results.violations, null, 2),
          contentType: 'application/json',
        });
      }

      expect(
        results.violations,
        `WCAG violations found in test "${testInfo.title}". See attached report.`
      ).toEqual([]);
    };

    await use(runA11y);
  },
});
