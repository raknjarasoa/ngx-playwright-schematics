import { Locator, Page, expect, test } from '@playwright/test';

export class ModalComponent {
  readonly root: Locator;
  readonly closeButton: Locator;
  readonly title: Locator;
  readonly bodyText: Locator;

  constructor(private readonly page: Page, rootLocator?: Locator) {
    this.root = rootLocator || page.getByRole('dialog').or(page.locator('.modal, [data-test="modal"]'));
    this.closeButton = this.root.getByRole('button', { name: /close|dismiss/i }).or(this.root.locator('.close-button, [data-test="close-button"]'));
    this.title = this.root.getByRole('heading', { level: 2 }).or(this.root.locator('h2, .modal-title'));
    this.bodyText = this.root.locator('.modal-body, .content');
  }

  async isOpen(): Promise<boolean> {
    return await this.root.isVisible().catch(() => false);
  }

  async close(): Promise<void> {
    await test.step('Close modal dialog', async () => {
      if (await this.isOpen()) {
        await this.closeButton.click();
        await expect(this.root).toBeHidden();
      }
    });
  }

  async closeModal(): Promise<void> {
    await this.close();
  }
}
